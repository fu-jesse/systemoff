#include "dk_l15_lm20_common.overlay"

/* uart20: keep only the TX pin */
&uart20_default {
	group1 {
		psels = <NRF_PSEL(UART_TX, 1, 16)>;
	};

	/delete-node/ group2;
};

&uart20_sleep {
	group1 {
		psels = <NRF_PSEL(UART_TX, 1, 16)>;
		low-power-enable;
		bias-pull-up;
	};

	/delete-node/ group2;
};
